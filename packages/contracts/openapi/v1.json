{
  "openapi": "3.1.0",
  "info": {
    "title": "Agenda BR foundation API",
    "version": "1.0.0",
    "description": "BK-005 executable foundation only. Proposed business routes are added before their respective implementation slices.",
    "license": {
      "name": "Private \u2014 all rights reserved"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Deployment origin; operation paths include /v1."
    }
  ],
  "security": [],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getWorkspaceInfo",
        "summary": "Process liveness diagnostic only",
        "description": "Public, contains no tenant/customer data; does not prove database, queue or provider readiness. Unknown query parameters are rejected.",
        "security": [],
        "responses": {
          "200": {
            "description": "The foundation process is running.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "default": {
            "description": "Safe failure with a correlation reference.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "description": "Optional UUID for request correlation; invalid or combined values are replaced by a server UUID. It grants no authority.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Process liveness diagnostic only",
        "description": "Compatibility liveness alias. New API consumers use /v1/health.",
        "security": [],
        "responses": {
          "200": {
            "description": "The foundation process is running.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "default": {
            "description": "Safe failure with a correlation reference.",
            "headers": {
              "X-Correlation-ID": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "deprecated": true,
        "parameters": [
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "description": "Optional UUID for request correlation; invalid or combined values are replaced by a server UUID. It grants no authority.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "components": {
    "headers": {
      "CorrelationId": {
        "description": "Server-issued UUID, or a validated incoming X-Correlation-ID UUID; never authorization.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "WorkspaceInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "stage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "const": "foundation"
          }
        }
      },
      "EmptyQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "PaginationQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Opaque URL-safe cursor, scoped and verified by each future list repository; never an authorization token."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "next_cursor",
          "limit"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "CursorPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "page_info"
        ],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 100,
            "items": {}
          },
          "page_info": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "description": "Reusable envelope only; each list operation must specialize data items and use stable repository ordering."
      },
      "BookingAcceptance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_version_id",
          "summary_hash",
          "confirmed"
        ],
        "properties": {
          "policy_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "summary_hash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "CreateBookingInput": {
        "description": "Reserved input shape from ET section 13.2; no booking endpoint is implemented by BK-005. Identity/tenant/price are server-derived. Acceptance still requires domain revalidation.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote_id",
          "acceptance"
        ],
        "properties": {
          "quote_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "acceptance": {
            "$ref": "#/components/schemas/BookingAcceptance"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "code"
        ],
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "body",
              "query"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_VALUE"
            ]
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "ACCEPTANCE_REQUIRED",
          "AUTH_REQUIRED",
          "SESSION_EXPIRED",
          "FORBIDDEN",
          "RESOURCE_NOT_FOUND",
          "SLOT_UNAVAILABLE",
          "VERSION_CONFLICT",
          "POLICY_CHANGED",
          "QUOTE_EXPIRED",
          "QUOTE_CONSUMED",
          "IDEMPOTENCY_CONFLICT",
          "BOOKING_CREATION_SUSPENDED",
          "HUMAN_REVIEW_REQUIRED",
          "CONVERSATION_NOT_BOT_ACTIVE",
          "RATE_LIMITED",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL_ERROR",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "METHOD_NOT_ALLOWED"
        ]
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "correlation_id",
              "field_errors",
              "retryable"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "correlation_id": {
                "type": "string",
                "format": "uuid"
              },
              "field_errors": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                }
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
