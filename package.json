{
  "name": "agenda-br",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "build": "node scripts/check-toolchain.mjs && node scripts/check-boundaries.mjs && node scripts/build.mjs",
    "build:packages": "node scripts/workspaces.mjs build --packages",
    "typecheck": "node scripts/workspaces.mjs build --packages && node scripts/workspaces.mjs typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "node --test scripts/check-boundaries.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/check.mjs",
    "dev:web": "npm run dev --workspace=@agenda/web",
    "start:api": "node --env-file=.env apps/api/dist/main.js",
    "start:worker": "node --env-file=.env apps/worker/dist/main.js",
    "verify:clean": "node scripts/verify-clean.mjs",
    "test:config": "node --test scripts/config.test.mjs",
    "check:web-secrets": "node scripts/check-web-secrets.mjs",
    "db:migrate": "node scripts/database/migrate.mjs",
    "test:database": "node scripts/check-toolchain.mjs && npm run build:packages && node --test --test-concurrency=1 scripts/database/database.test.mjs",
    "test:clock": "node --test scripts/database/clock.test.mjs",
    "contracts:generate": "node scripts/contracts/generate.mjs",
    "contracts:check": "node scripts/contracts/generate.mjs --check",
    "test:contracts": "node --test scripts/contracts/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "pg": "8.23.1",
    "@redocly/openapi-core": "1.34.6",
    "openapi-typescript": "6.7.6"
  }
}
